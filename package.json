{
  "name": "blai-product-designer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply blai-designer --local",
    "preview": "vite preview --host 127.0.0.1",
    "helper": "node bridge/start.mjs",
    "deploy": "npm run build && wrangler deploy",
    "test:helper": "node --test tests/helper.node.mjs",
    "test:e2e": "node tests/e2e-app.mjs && node tests/e2e-wireframe.mjs && node tests/e2e-board.mjs && node tests/e2e-resilience.mjs && node tests/e2e-flows.mjs",
    "helper:configure": "node bridge/configure-linux.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "date-fns": "4.4.0",
    "fflate": "0.8.3",
    "jose": "6.2.12",
    "lucide-react": "1.58.0",
    "pele": "1.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261016.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "miniflare": "5.20261012.0-beta",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
